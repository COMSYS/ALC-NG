# The address the built app is served from, with a trailing slash. It fills
# the canonical link and the og:/twitter: URLs of site/index.html, which have
# to be absolute for a link preview to resolve the card image. Override it
# for a deployment: VITE_SITE_URL=https://example.org/alc-ng/ pnpm build
VITE_SITE_URL=https://alc.ng/
